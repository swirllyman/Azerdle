# CurseForge packager: the addon lives in Azerdle/, not at the repo root. The repo is checked out as
# Azerdle/, the addon folder is moved out to the top of the zip, and the rest is left out.
package-as: Azerdle

move-folders:
  Azerdle/Azerdle: Azerdle

ignore:
  - tools
  - CLAUDE.md
  - README.md
